# Output artifacts
# outputs/
outputs_v2/
outputs_final/
# Deny all PDFs by default but allow Education SATs outputs
*.pdf
!outputs/education/sats_2026/**/*.pdf
!outputs/Law/EmploymentTribunal/v19_et1_clarification/**/*.pdf
!outputs/Law/EmploymentTribunal/v19.1_et1_clarification/**/*.pdf
!outputs/GrandOperation_vInfinity/**/*.pdf
*.tex
*.png
*.gif
*.mp4
*.wav
*.mp3
*.txt
# …but the Python deps manifest MUST be tracked (the blanket *.txt above accidentally
# excluded it, leaving fresh clones / Render deploys with no installable requirements).
!requirements.txt
# Python cache
__pycache__/
*.pyc
# Node
node_modules/
dist/
build/
# Logs
*.log
*.jsonl

# Data & Secrets
data/organism/
data/demo/
data/test_state/
data/test_bundles/
data/test_evidence_graph.json
*.pem
products/mjm-intelligence-engine/checkpoints/
products/mjm-intelligence-engine/artifacts/
.hypothesis/

agentic_core/service-account-key.json
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.env
data/
# …but the broad data/ rule above also matches the frontend's source assets at
# apps/workstation-superapp/src/data/ — those are TRACKED source (imported by the
# app, e.g. fallbackData.json) and must ship, or the production build fails.
!apps/workstation-superapp/src/data/
logs/
state_snapshots/
sandbox/
.env

# Runtime UEG / GaaS audit-log state (generated, hash-chained — not source)
meta/*ueg*.json
**/meta/*ueg*.json
