import argparse
import asyncio
import logging
import sys
from agentic_core.jules_omega_organism_v138 import JulesOmegaOrganismV138
from agentic_core.fractal_recirculation import FractalRecirculation

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    handlers=[logging.StreamHandler(sys.stdout)]
)

logger = logging.getLogger("InitJules")

async def main(args):
    logger.info("Initializing JULES v138.0 Production Beta Organism...")

    organism = JulesOmegaOrganismV138()
    await organism.initialize()

    fractal = FractalRecirculation(organism)

    if args.dry_run:
        logger.info("Dry run: Executing one Macro cycle and shutting down.")
        await organism.run_macro_cycle()
        await organism.shutdown()
        return

    # Windows-compatible signal handling
    try:
        await fractal.start_loops()
    except (asyncio.CancelledError, KeyboardInterrupt):
        logger.info("Shutdown requested.")
    finally:
        await organism.shutdown()

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Jules v138.0 Initializer")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--deploy", type=str, default="beta")
    args = parser.parse_args()

    try:
        asyncio.run(main(args))
    except (KeyboardInterrupt, SystemExit):
        logger.info("Received exit signal.")
