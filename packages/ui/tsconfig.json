{
  "compilerOptions": {
    "paths": {
      "@superapp/*": ["../../apps/workstation-superapp/src/*"]
    },
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "5.0",   // W506 (FU-261): 6.0 is invalid for TypeScript 5.9.3 (TS5103), so this package could not be typechecked alone
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"]
  },
  "include": ["src"]
}