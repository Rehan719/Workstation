rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Standard user data isolation
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Subscription data with twin reflection access
    match /subscriptions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Usage counters with twin predictive access
    match /usage/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == docId.split('_')[0];
    }

    // Webhook idempotency log
    match /webhook_events/{eventId} {
      allow read, write: if false;
    }

    // UEG log: immutable twin memory
    match /ueg_log/{doc} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    // Geospheric state: twin organs
    match /geospheric/{cycle}/{stateDoc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Twin state snapshots
    match /twin_snapshots/{doc} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }
  }
}
