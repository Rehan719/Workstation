# Workstation — Environment Variables.  Copy to .env and edit:  cp .env.example .env
# Defaults are COST-FREE and in-house-first: the backend boots + fully serves with NO external key and
# NO paid service. Every cost-incurring switch below is OFF by default — enable on your own accounts.

# ── AI posture: IN-HOUSE-FIRST ($0 by default) ────────────────────────────────
# The native structured engine is the always-available floor; a self-hosted Ollama model is used when
# present. External providers are OPTIONAL accelerants — used ONLY when AI_ALLOW_EXTERNAL=true AND a key
# is set. They incur per-token cost, so they are OFF by default.
AI_ALLOW_EXTERNAL=false
OLLAMA_URL=http://localhost:11434/api/generate    # optional self-hosted local model ($0)
OLLAMA_MODEL=llama3.2
# OLLAMA_VISION_MODEL=llava                        # optional, for in-house avatar vision ($0)
# ANTHROPIC_API_KEY=sk-ant-...   # OPTIONAL — external accelerant, PER-TOKEN COST (needs AI_ALLOW_EXTERNAL=true)
# OPENAI_API_KEY=sk-...          # OPTIONAL — multimodal STT/TTS + accelerant, PER-TOKEN COST
CLAUDE_MODEL=claude-sonnet-4-6
GATEWAY_MAX_TOKENS=4096
GATEWAY_RPM=20                    # cap on AI calls/min — guards against runaway external spend

# ── Storage / persistence ─────────────────────────────────────────────────────
# All platform data lives under DATA_DIR. For production, point this at (or mount a persistent volume
# on) a durable path so data survives redeploys. Local file persistence is $0; a managed DB is optional.
DATA_DIR=data
PROJECTS_DIR=data/projects
PROPOSALS_DIR=data/proposals
SYNTHESIS_OUTPUT_DIR=data/synthesis_outputs

# ── Payments — VIRTUAL / TEST ONLY by default (NO real money) ─────────────────
# The platform uses virtual WST internally. If you wire Stripe, use a TEST key (no real money, no fees).
# NEVER commit a live (sk_live_) key, and never enable live mode without an explicit decision.
# STRIPE_SECRET_KEY=sk_test_...        # TEST mode only
# STRIPE_LIVE_ENABLED=false            # MUST stay false until you deliberately go live (real money + fees)

# ── App / security ────────────────────────────────────────────────────────────
ENVIRONMENT=production
CORS_ORIGINS=                    # your frontend URL(s), e.g. https://your-app.vercel.app
AUTH_ENABLED=false               # set true to require JWT auth
# JWT_SECRET=                    # set explicitly in production (auto-generated otherwise)
# ADMIN_PASSWORD=                # override the default before going live
LOG_LEVEL=INFO

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
