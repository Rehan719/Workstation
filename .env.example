# Workstation — Environment Variables
# Copy to .env and fill in your keys before starting.
# cp .env.example .env

# ── AI Provider (priority: Anthropic → OpenAI → Ollama local) ─────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: OpenAI fallback
# OPENAI_API_KEY=sk-...

# Optional: Ollama local fallback (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2

# ── AI Model ──────────────────────────────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-6
GATEWAY_MAX_TOKENS=4096
# Max AI calls per minute across all endpoints — prevents runaway API spend
GATEWAY_RPM=20

# ── Storage ───────────────────────────────────────────────────────────────────
# Local paths (defaults — override for production mounts)
PROJECTS_DIR=data/projects
PROPOSALS_DIR=data/proposals
SYNTHESIS_OUTPUT_DIR=data/synthesis_outputs

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Backend API base for the React app (used by Vercel rewrite in production)
VITE_API_BASE_URL=http://localhost:8000
